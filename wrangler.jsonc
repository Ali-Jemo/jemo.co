{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jemo-co",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "lab.jemo.dev",
			"custom_domain": true
		}
	],
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://okekfsfyydajyfarnzra.supabase.co",
		"SUPABASE_URL": "https://okekfsfyydajyfarnzra.supabase.co",
		// NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is inlined at build time. Put it in
		// these vars (or CI env) before `opennextjs-cloudflare build`. A Worker
		// secret alone leaves the client bundle with an empty key.
		// CLERK_SECRET_KEY is a runtime secret: wrangler secret put CLERK_SECRET_KEY
		// CLERK_FRONTEND_API (https host) lets CSP allow the production Clerk domain.
		"NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
		"NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
		"NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/",
		"NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/"
	}
}
