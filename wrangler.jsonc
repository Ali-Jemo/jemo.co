{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jemo-co",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "lab.jemo.dev",
			"custom_domain": true
		}
	],
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://okekfsfyydajyfarnzra.supabase.co",
		"SUPABASE_URL": "https://okekfsfyydajyfarnzra.supabase.co",
		"NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_YmFsYW5jZWQtY3ViLTQ2OTEuY2xlcmsuYWNjb3VudHMuZGV2JA",
		"CLERK_PUBLISHABLE_KEY": "pk_test_YmFsYW5jZWQtY3ViLTQ2OTEuY2xlcmsuYWNjb3VudHMuZGV2JA",
		"NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
		"NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
		"NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/",
		"NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/"
	}
}
