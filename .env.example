# Public site origin. Inlined at build time. Default in code is https://lab.jemo.dev.
NEXT_PUBLIC_SITE_URL=https://lab.jemo.dev

# Public inbox. Inlined at build time when prefixed NEXT_PUBLIC_.
# Default in code is contact@jemo.dev. Privacy and legal fall back to the
# same address unless their own variables are set.
NEXT_PUBLIC_CONTACT_EMAIL=contact@jemo.dev
CONTACT_EMAIL=contact@jemo.dev
# NEXT_PUBLIC_PRIVACY_EMAIL=
# PRIVACY_EMAIL=
# NEXT_PUBLIC_LEGAL_EMAIL=
# LEGAL_EMAIL=

# Optional JSON array of { "id", "href", "label" }. href must be https.
# Default is Telegram (t.me/jemo_channel) and GitHub (Ali-Jemo). Do not add
# https://x.com/jemolabs — that profile 404s.
# NEXT_PUBLIC_SOCIAL_LINKS=

# Show the committed sample papers and news in a production build.
# Default: visible in development, hidden when NODE_ENV=production.
# NEXT_PUBLIC_SHOW_UNVERIFIED_SAMPLES=0

# Overlay dashboard rows from Supabase onto the committed defaults.
# Must be present at BUILD time to affect prerendered pages. Leave unset
# unless the service-role key is available to the build; a missing or slow
# database used to turn public pages into Worker 500s.
# JEMO_LIVE_CONTENT=0

# Clerk. The publishable key is inlined into the client bundle at build time.
# Setting it only with `wrangler secret put` leaves publishableKey="" and the
# sign-in skeleton never resolves. Put it in wrangler vars or CI env, then rebuild.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# Runtime secret only (not NEXT_PUBLIC):
# CLERK_SECRET_KEY=sk_live_...
# Production Frontend API host, so CSP allows it. Example: https://clerk.lab.jemo.dev
# CLERK_FRONTEND_API=

# Supabase. URL may be public. The service-role key is a Worker secret.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Contact form delivery. Without both, the form stores nothing and returns 503;
# the mailto link to contact@jemo.dev still works.
# RESEND_API_KEY=
# EMAIL_FROM=
